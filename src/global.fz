# effect for holding global state in the webserver
#
module global(init_background_tasks bool) : effect is

  max_open_sessions => 1E3
  eviction_count => 1E2
  sessions := lock_free.Map String Session .empty


  # store a session
  module sessions_put(id String, s Session) =>
    sessions.put id s


  module sessions_get(id String) option Session =>
    match sessions.get id
      nil => nil
      s Session =>
        session_last_accessed_bm.env.exclusive ()->
          s.last_accessed <- time.now.env.get

        s


  module feeds := Feeds

  module blocklists := Blocklists

  max_cached_files => 25
  files := lock_free.Sieve_Cache io.path (outcome String) (lock_free.Map io.path (lock_free.Node io.path (outcome String))) max_cached_files

  module read_file_as_string(p io.path) =>
    files.access p ()->
      universe.read_file_as_string p


  if init_background_tasks
    feeds.init

    blocklists.init

    _ := concur.Threads.env.spawn ()->
      do
        fuzion.runtime.fault
          .try ()->
            session_last_accessed_bm.env.exclusive_when ()->sessions.size>max_open_sessions ()->
              sessions
                .items
                .sort_by (.1.last_accessed.get)
                .map (.0)
                .take eviction_count # evict `eviction_count` sessions
                .map sessions.remove
                .for_each ignore     # force execution of `remove`
          .catch e->
            logger.log $e
