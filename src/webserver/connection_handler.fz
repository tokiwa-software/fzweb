# contains convenient access of request
# like header fields, a send feature etc.
#
request_context (LM type : mutate, connection net.connection) is
  timestamp := time.Nano.env.read
  request := (http.read_request LM).or_panic

  path => (request.target.split "?").first.or_panic
  query_string => ((request.target.split "?").drop 1).first ""

  x_forwarded_for := request.header["x-forwarded-for"]
    .or_else ""
    .split ","
    .first ""
    .trim
    |> net.ip_address.type.from_string

  client :=
    x_forwarded_for
      .or_else (net.endpoint.env.get_peer_address.or_else (net.ip_address u128.zero))


  # send an HTTP response on the current socket
  #
  # closes the connection after sending or
  # if /events connection saves it in the session
  #
  # return_code specifies the HTTP status code of the response
  # attributes defines the headers of the response
  # data contains the body of the response as an array of bytes
  #
  send(response response) =>
    match (io.buffered LM)
              .Writer.env
              .write (response.bytes LM)
      e error => logger.log e
      unit =>
        match (io.buffered LM).Writer.env.flush
          e error => logger.log e
          unit    =>

    match response.session
      nil =>
        match connection.close
          e error => logger.log "failed closing connection $(e)"
          unit    =>
      s Session =>
        check debug : path = "/events"
        s.set_connection connection



# entry point to the handling the request
#
module handle_connection (LM type : mutate, conn net.connection) unit =>

  req_context := request_context LM conn

  logger.log "$(req_context.request.method) $(req_context.request.target)"

  match form_data req_context
    fd container.Map =>
      resp := match req_context.request.method
        http.get, http.post_r => route_request req_context.path req_context.request.method req_context.client fd req_context.query_string
        * => response.new 500

      req_context.send resp

      log_request_duration req_context fd["page"]

    e error =>
      logger.log e
      req_context.send (response.new 415 (map_of_strings [("Accept", "application/x-www-form-urlencode, multipart/form-data")]))



# log long running requests
#
log_request_duration(LM type : mutate, req_context request_context LM, page option String) =>

  # do not log anything for connection that is intentionally kept open
  if req_context.path != "/events"
    max_time := time.duration.ms 500
    request_duration := time.Nano.env.read - req_context.timestamp
    if request_duration ≥ max_time
      msg :=
        if req_context.path = "/goto" && page.ok
          "took $(request_duration) to process request for $(page.or_panic) (via eventstream)"
        else
          "took $(request_duration) to process request for $(req_context.path)"

      logger.log msg



# extract form data from request_context
#
form_data(LM type : mutate, req_context request_context LM) =>

  # get the content length from the headers
  #
  content_length =>
    req_context
      .request
      .header["content-length"]
      .or_else "0"
      .parse_i64
      .or_else 0

  lm : mutate is
  read_content => lm ! ()->

    # NYI: CLEANUP: http.Message should have a method
    # to create such a Reader

    r : io.buffered lm .Reader is
      public redef read (max_count i64) choice (Sequence u8) io.end_of_file error =>
        req_context.request.body max_count

    (io.buffered lm).Reader.instate r ()->
      (io.buffered lm).read_bytes content_length


  read_content.bind post_data_raw->
    post_data := String.from post_data_raw
    req_context.request.header["content-type"]
      .bind ct->
        val := webserver.mime_value.from_type_string ct
        content_type := val.mime_type
        content_type_boundary := val["boundary"].or_default ""
        get_form_data post_data req_context.request.method req_context.query_string content_type content_type_boundary
      .or_else (get_form_data post_data req_context.request.method req_context.query_string "" "")
